# Copy to .env (untracked) for local testing, or set these in the backend
# host's SERVER environment settings (e.g. Vercel → Settings → Environment
# Variables). Never prefix server settings with VITE_ – VITE_* values are
# embedded into the public JavaScript bundle.

# ---- The Royal Wish Vault (server only, private) ----
# The owner's access code for the hidden vault. Choose something long.
VAULT_ACCESS_CODE=
# Optional: separate secret used to sign vault sessions (recommended).
VAULT_SESSION_SECRET=

# ---- Persistent storage: Upstash Redis (server only, private) ----
# From the Upstash console (REST API section). Vercel's Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead – either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Cross-origin (server only) ----
# The page origins allowed to call the API, comma-separated, e.g.
# https://wilan789pro.github.io
WISH_ALLOWED_ORIGINS=

# ---- Frontend (PUBLIC – ends up in the JavaScript bundle; never a secret) ----
# Address of the separately hosted API, e.g. https://your-api.vercel.app
# (no trailing /api). Empty = wishes and the vault are not connected.
VITE_API_BASE_URL=
