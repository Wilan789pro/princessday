# Copy to .env (untracked) for local testing, or set these in the hosting
# provider's SERVER environment settings. Never prefix them with VITE_ –
# VITE_* variables are embedded into the public JavaScript bundle.
#
# Leave them empty to keep /api/wish in dry-run mode (nothing is sent).
RESEND_API_KEY=
WISH_TO_EMAIL=
WISH_FROM_EMAIL=
# Required when the site is served from another origin (e.g. GitHub Pages):
# comma-separated list of allowed page origins, e.g. https://wilan789pro.github.io
WISH_ALLOWED_ORIGINS=

# ---- Frontend (PUBLIC – ends up in the JavaScript bundle; never a secret) ----
# Address of the separately hosted API that receives wishes, e.g.
# https://your-api.example.app (no trailing /api). Empty = not connected.
VITE_API_BASE_URL=
